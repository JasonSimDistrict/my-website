---
import BaseLayout from '../../../layouts/BaseLayout.astro';

// Each entry below is one Huttons issue / brochure. Add new objects to the top
// of this array when a new Huttons Update is published (newest first).
const updates = [
  {
    date: '23 Oct 2026',
    datetime: '2026-10-23',
    title: 'Residential Hottest Picks (Oct 2026)',
    description:
      'Huttons’ October 2026 Residential Collection — a curated short-list of hot 3- and 4-bedroom residences with location maps, tenure, unit size ranges and starting prices across standout projects like Amberwood at Holland, Dunearn House, The Orie, Aurea and Union Square Residences.',
    thumbnail: '/assets/images/huttons-residential-hottest-picks-oct-2026-cover.png',
    thumbAlt:
      'Huttons Residential Hottest Picks brochure cover — October 2026, curated 3 & 4 bedroom residences',
    pdf: '/assets/downloads/Huttons_Residential_Hottest_Picks_23_Oct_2026.pdf',
    fileSize: '1.3 MB',
    pdfName: 'Huttons_Residential_Hottest_Picks_23_Oct_2026.pdf',
  },
  {
    date: '14 Oct 2026',
    datetime: '2026-10-14',
    title: 'Unlock Dreams — The Ultimate Guide to EC',
    description:
      'Huttons’ definitive buyer guide to Singapore’s next wave of Executive Condominiums — 12 reasons an EC is the smart next-home choice, the North Region transformation story (Sembawang, Yishun, Woodlands, Bukit Panjang, Kranji, the North-South Corridor), and project spotlights on five upcoming EC launches: Solano Grand, Wynwood Grand, Sembawang Road, Clovelle of Woodlands and Miltonia Close.',
    thumbnail: '/assets/images/huttons-unlock-dreams-ec-oct-2026-cover.png',
    thumbAlt:
      'Huttons Unlock Dreams brochure cover — The Ultimate Guide to Executive Condominium, with a young family looking out at a Singapore condo skyline',
    pdf: '/assets/downloads/Huttons_Unlock_Dreams_Ultimate_Guide_to_EC_14_Oct_2026.pdf',
    fileSize: '3.6 MB',
    pdfName: 'Huttons_Unlock_Dreams_Ultimate_Guide_to_EC_14_Oct_2026.pdf',
  },
  {
    date: '13 Oct 2026',
    datetime: '2026-10-13',
    title: 'Huttons Curated Opportunities',
    description:
      'A curated three-section Huttons briefing — Upcoming Launches, Latest Highlights, and Featured Projects — covering priority access to new releases, limited-time promotions, and value-aligned shortlists across Singapore.',
    thumbnail: '/assets/images/huttons-curated-opportunities-oct-2026-cover.png',
    thumbAlt:
      'Huttons Curated Opportunities brochure cover — featuring the Media Circle development, Exclusive · Limited · Curated',
    pdf: '/assets/downloads/Huttons_Curated_Opportunities_13_Oct_2026.pdf',
    fileSize: '1.4 MB',
    pdfName: 'Huttons_Curated_Opportunities_13_Oct_2026.pdf',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://projecthome.sg/' },
        { '@type': 'ListItem', position: 2, name: 'Insights & News', item: 'https://projecthome.sg/blog' },
        { '@type': 'ListItem', position: 3, name: 'Huttons Update', item: 'https://projecthome.sg/blog/huttons-update' },
      ],
    },
    {
      '@type': 'CollectionPage',
      '@id': 'https://projecthome.sg/blog/huttons-update#collection',
      url: 'https://projecthome.sg/blog/huttons-update',
      name: 'Huttons Update — Agency Briefings for Singapore Buyers',
      description:
        'Official Huttons briefings, curated opportunities and new launch highlights — summarised by the ProjectHome.sg editorial team, with the original PDF available to download.',
      inLanguage: 'en-SG',
    },
  ],
};
---

<BaseLayout
  title="Huttons Update: Agency Briefings & Curated Opportunities | ProjectHome.sg"
  description="Official Huttons Asia briefings — curated opportunities, new launch highlights and featured projects for Singapore buyers and investors. Each issue summarised by the ProjectHome.sg editorial team, with the original PDF free to download."
  keywords="Huttons Update, Huttons Asia briefing, Huttons Curated Opportunities, Singapore new launch opportunities, Huttons priority access, ProjectHome.sg Huttons"
  canonical="https://projecthome.sg/blog/huttons-update"
  ogTitle="Huttons Update: Agency Briefings & Curated Opportunities"
  ogDescription="Official Huttons Asia briefings for Singapore buyers and investors — summarised, with the original PDF free to download."
  ogImage="https://projecthome.sg/assets/images/huttons-curated-opportunities-oct-2026-cover.png"
  whatsappContext="the latest Huttons Update"
  schema={schema}
>

  <style is:global slot="head-extra">
    .hu-list {
      display: grid;
      gap: 20px;
      margin-top: 10px;
    }
    .hu-row {
      display: grid;
      grid-template-columns: 160px 1fr auto auto;
      gap: 24px;
      align-items: center;
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: 20px 24px;
      box-shadow: 0 2px 8px rgba(6, 57, 67, 0.06);
      transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }
    .hu-row:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 26px rgba(6, 57, 67, 0.12);
      border-color: rgba(209, 149, 87, 0.5);
    }
    .hu-thumb {
      display: block;
      width: 160px;
      aspect-ratio: 595 / 842;
      border-radius: var(--radius);
      overflow: hidden;
      background: #0a2d5b;
      box-shadow: 0 4px 12px rgba(6, 57, 67, 0.18);
      line-height: 0;
      transition: transform 0.18s ease, box-shadow 0.18s ease;
    }
    .hu-thumb:hover,
    .hu-thumb:focus-visible {
      transform: scale(1.02);
      box-shadow: 0 10px 22px rgba(6, 57, 67, 0.28);
      outline: none;
    }
    .hu-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .hu-body { min-width: 0; }
    .hu-date {
      display: inline-block;
      font-size: 0.72rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--copper);
      margin-bottom: 8px;
    }
    .hu-title {
      margin: 0 0 8px;
      color: var(--teal);
      font-size: 1.3rem;
      line-height: 1.3;
    }
    .hu-title a { color: inherit; text-decoration: none; }
    .hu-title a:hover { color: var(--copper); }
    .hu-desc {
      margin: 0;
      color: #3a4a4d;
      font-size: 0.95rem;
      line-height: 1.55;
    }
    .hu-size {
      color: var(--teal);
      font-weight: 700;
      font-size: 0.95rem;
      white-space: nowrap;
      padding: 0 4px;
    }
    .hu-size .lbl {
      display: block;
      font-size: 0.68rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      font-weight: 700;
      color: #607074;
      margin-bottom: 2px;
    }
    .hu-download {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      white-space: nowrap;
    }
    .hu-download .arrow { transition: transform 0.18s ease; }
    .hu-download:hover .arrow { transform: translateY(2px); }

    @media (max-width: 820px) {
      .hu-row {
        grid-template-columns: 110px 1fr;
        grid-template-areas:
          "thumb body"
          "size size"
          "dl dl";
        gap: 16px 18px;
        padding: 18px 18px;
      }
      .hu-thumb { width: 110px; grid-area: thumb; }
      .hu-body { grid-area: body; }
      .hu-size { grid-area: size; padding: 0; display: flex; align-items: baseline; gap: 8px; }
      .hu-size .lbl { display: inline; margin: 0; }
      .hu-download { grid-area: dl; justify-content: center; }
    }

    .hu-cta-form {
      margin: 44px 0 10px;
      padding: 36px 36px 40px;
      background: linear-gradient(135deg, #ffffff 0%, var(--paper) 100%);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      box-shadow: 0 6px 24px rgba(6, 57, 67, 0.08);
    }
    .hu-cta-form .cta-eyebrow {
      display: inline-block;
      font-size: 0.72rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--copper);
      margin-bottom: 10px;
    }
    .hu-cta-form h2 { color: var(--teal); margin: 0 0 10px; font-size: 1.5rem; }
    .hu-cta-form > p.intro { color: #3a4a4d; margin: 0 0 22px; }
    .hu-cta-form .lead-form { margin-top: 0; }

    @media (max-width: 640px) {
      .hu-cta-form { padding: 28px 22px 30px; }
    }
  </style>

  <section class="page-banner">
    <div class="page-banner-inner">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep" aria-hidden="true">›</span>
        <a href="/blog">Insights &amp; News</a>
        <span class="sep" aria-hidden="true">›</span>
        <span class="current" aria-current="page">Huttons Update</span>
      </nav>
      <span class="eyebrow">Insights &amp; News · Huttons Update</span>
      <h1>Huttons Update: Agency Briefings for Singapore Buyers</h1>
      <p>Official Huttons Asia briefings and curated opportunity decks &mdash; each issue summarised by the ProjectHome.sg editorial team, with the original PDF free to download.</p>
    </div>
  </section>

  <section class="blog-section">
    <div class="container">

      <!-- Issue row(s) — thumbnail + title + file size + download link -->
      <div class="hu-list" role="list">
        {updates.map((u) => (
          <article class="hu-row" role="listitem">
            <a
              class="hu-thumb"
              href={u.pdf}
              target="_blank"
              rel="noopener"
              aria-label={`Open ${u.pdfName} in a new tab`}
            >
              <img src={u.thumbnail} alt={u.thumbAlt} loading="lazy" decoding="async" />
            </a>

            <div class="hu-body">
              <span class="hu-date">
                <time datetime={u.datetime}>{u.date}</time>
              </span>
              <h2 class="hu-title">
                <a href={u.pdf} target="_blank" rel="noopener">{u.title}</a>
              </h2>
              <p class="hu-desc">{u.description}</p>
            </div>

            <div class="hu-size">
              <span class="lbl">File size</span>
              <span>PDF &middot; {u.fileSize}</span>
            </div>

            <a
              class="btn btn-primary hu-download"
              href={u.pdf}
              target="_blank"
              rel="noopener"
              aria-label={`Download ${u.pdfName} (opens in a new tab)`}
            >
              Download <span class="arrow" aria-hidden="true">↓</span>
            </a>
          </article>
        ))}
      </div>

      <!-- Lead form -->
      <section class="hu-cta-form" aria-labelledby="hu-form-head">
        <span class="cta-eyebrow">Stay Informed</span>
        <h2 id="hu-form-head">Get the next Huttons Update &mdash; and more</h2>
        <p class="intro">Priority access to Huttons new releases, quarterly market reports, buyer guides, and district spotlights &mdash; delivered the week they matter. No spam, ever.</p>

        <form id="lead-form" class="lead-form" novalidate>
          <div class="form-success" role="status" aria-live="polite"></div>
          <input type="hidden" name="source" value="Huttons Update" />
          <div class="hp-field" aria-hidden="true"><label for="website">Don't fill this out if you're human</label><input type="text" id="website" name="website" tabindex="-1" autocomplete="off" /></div>
          <div class="field"><label for="name">Your Name</label><input type="text" id="name" name="name" placeholder="e.g. Jonathan Tan" /></div>
          <div class="field"><label for="email">Email Address *</label><input type="email" id="email" name="email" required placeholder="you@example.com" /></div>
          <div class="field"><label for="phone">Mobile Contact</label><input type="tel" id="phone" name="phone" placeholder="e.g. 9123 4567" /></div>
          <div class="field"><label for="interest">I&rsquo;m most interested in</label><select id="interest" name="interest">
            <option>New Launch Alerts</option>
            <option>Quarterly Market Reports</option>
            <option>Buyer Guides and How-tos</option>
            <option>District Spotlights</option>
            <option>All of the above</option>
          </select></div>
          <div class="field"><label for="message">Remarks (optional)</label><textarea id="message" name="message" placeholder="e.g. budget, bedroom type, timeline, specific project&hellip;"></textarea></div>
          <button type="submit" class="btn btn-primary">Send Enquiry</button>
        </form>
      </section>

    </div>
  </section>

</BaseLayout>
